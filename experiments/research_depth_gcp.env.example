# Copy this file outside the repository, fill in machine-specific paths, then:
#   set -a
#   source /path/to/research_depth_gcp.env
#   set +a

GUROBI_HOME=/opt/gurobi/linux64
CPLEX_STUDIO_DIR=/opt/ibm/ILOG/CPLEX_Studio2211
EVALMAXSAT_BIN=/opt/evalmaxsat/EvalMaxSAT_bin

# Freeze this to the commit used for every measured run.
HCORAP_EXPECTED_COMMIT=replace-with-full-commit-sha
HCORAP_PROVENANCE_REMOTE=origin

# A persistent disk outside the repository is strongly recommended.
HCORAP_BACKUP_DIR=/mnt/disks/hcorap-backup

# Match these to the GCP VM. All solver runs remain single-threaded.
HCORAP_EXPECTED_VCPUS=8
HCORAP_BUILD_JOBS=8
# HCORAP_CPU_CORE=0

# Enable only after reviewing the printed matrices and pilot results.
# CONFIRM_RESEARCH_DEPTH_PILOT=YES
# CONFIRM_RESEARCH_DEPTH_FULL=YES
